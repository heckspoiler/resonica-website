{
  "format": "page",
  "id": "date",
  "label": "date",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "date_type": {
        "type": "StructuredText",
        "config": {
          "label": "Date/Event Type",
          "placeholder": "Club, Festival, Release",
          "allowTargetBlank": true,
          "multi": "paragraph"
        }
      },
      "hero_image": {
        "type": "Image",
        "config": {
          "label": "Event Hero Image",
          "constraint": {},
          "thumbnails": []
        }
      },
      "date_acts": {
        "type": "Group",
        "config": {
          "label": "Event Acts",
          "repeat": true,
          "fields": {
            "date_act": {
              "type": "Link",
              "config": {
                "label": "Act",
                "placeholder": "Name of Act & Link to SC in Linkfield",
                "allowTargetBlank": true,
                "select": null,
                "allowText": true
              }
            }
          }
        }
      },
      "ticket_link": {
        "type": "Link",
        "config": {
          "label": "Ticket Link",
          "placeholder": "TICKET or GET TICKETS or whatever you want",
          "allowTargetBlank": true,
          "select": null,
          "allowText": true
        }
      },
      "date_title": {
        "type": "StructuredText",
        "config": {
          "label": "Event Title",
          "placeholder": "Resonica at Zukunft",
          "allowTargetBlank": true,
          "multi": "heading2"
        }
      },
      "event_dates": {
        "type": "Group",
        "config": {
          "label": "Event Dates",
          "repeat": true,
          "fields": {
            "date": {
              "type": "Date",
              "config": {
                "label": "Date",
                "placeholder": ""
              }
            },
            "time": {
              "type": "Text",
              "config": {
                "label": "Time",
                "placeholder": "23:00 - 06:00"
              }
            }
          }
        }
      },
      "event_description_rich": {
        "type": "StructuredText",
        "config": {
          "label": "Event Description (Rich Text)",
          "placeholder": "Paragraphs, bold, italic, lists, links, H4/H5 – replaces the plain-text description",
          "allowTargetBlank": true,
          "multi": "paragraph,heading4,heading5,strong,em,hyperlink,list-item,o-list-item"
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  }
}
